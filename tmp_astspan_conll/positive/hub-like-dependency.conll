def	I
calculate_cyclomatic_complexity	I
(	I
self	I
,	I
method	I
)	I
:	I

        	I
"""
        Calculate cyclomatic complexity using a simplified approach.
        
        Counts:
        - if statements
        - elif branches
        - for loops
        - while loops
        - except blocks
        - boolean operations (and, or)
        
        Args:
            method (ast.FunctionDef): The method to analyze
            
        Returns:
            int: The cyclomatic complexity value
        """	I

complexity	I
=	I
1	I
# Base complexity	I

for	I
node	I
in	I
ast	I
.	I
walk	I
(	I
method	I
)	I
:	I

# Control flow statements	I

            	I
if	I
isinstance	I
(	I
node	I
,	I
ast	I
.	I
If	I
)	I
:	I

                	I
complexity	I
+=	I
1	I

# Count elif branches	I

complexity	I
+=	I
len	I
(	I
[	I
1	I
for	I
handler	I
in	I
node	I
.	I
orelse	I

if	I
isinstance	I
(	I
handler	I
,	I
ast	I
.	I
If	I
)	I
]	I
)	I

elif	I
isinstance	I
(	I
node	I
,	I
(	I
ast	I
.	I
For	I
,	I
ast	I
.	I
While	I
)	I
)	I
:	I

                	I
complexity	I
+=	I
1	I

elif	I
isinstance	I
(	I
node	I
,	I
ast	I
.	I
ExceptHandler	I
)	I
:	I

                	I
complexity	I
+=	I
1	I

# Boolean operations	I

elif	I
isinstance	I
(	I
node	I
,	I
ast	I
.	I
BoolOp	I
)	I
:	I

                	I
complexity	I
+=	I
len	I
(	I
node	I
.	I
values	I
)	I
-	I
1	I

return	I
complexity	I

