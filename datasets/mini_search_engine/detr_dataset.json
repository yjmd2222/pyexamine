  "text": "[file]\npath=mini_search_engine/cache.py\n\nclass Cache:\n    def __init__(self):\n        self._data = {}\n\n    def remember(self, key, value):\n        self._data[key] = value\n        return value\n\n[file]\npath=mini_search_engine/indexer.py\n\nclass Indexer:\n    def build(self, tokens):\n        return {token: idx for idx, token in enumerate(tokens)}\n\n[file]\npath=mini_search_engine/link_a.py\n\nimport link_b\n\n\ndef follow_a():\n    return link_b.follow_b()\n\n[file]\npath=mini_search_engine/link_b.py\n\nimport link_c\n\n\ndef follow_b():\n    return link_c.follow_c()\n\n[file]\npath=mini_search_engine/link_c.py\n\nimport link_a\n\n\ndef follow_c():\n    return link_a.follow_a()\n\n[file]\npath=mini_search_engine/queries.py\n\nclass QueryStore:\n    def __init__(self):\n        self.history = []\n\n    def add(self, query: str):\n        self.history.append(query)\n        return len(self.history)\n\n[file]\npath=mini_search_engine/ranking.py\n\nclass Ranker:\n    def rank(self, scores):\n        return sorted(scores, reverse=True)\n\n[file]\npath=mini_search_engine/registry.py\n\nimport indexer\nimport tokenizer\nimport storage\nimport cache\nimport ranking\nimport queries\n\n\ndef build_registry():\n    return {\n        \"indexer\": indexer.Indexer(),\n        \"tokenizer\": tokenizer.Tokenizer(),\n        \"storage\": storage.Storage(),\n        \"cache\": cache.Cache(),\n        \"ranking\": ranking.Ranker(),\n        \"queries\": queries.QueryStore(),\n    }\n\n[file]\npath=mini_search_engine/relations.py\n\nclass ProfileState:\n    def __init__(self, balance, status, limit, tier):\n        self.balance = balance\n        self.status = status\n        self.limit = limit\n        self.tier = tier\n\n\nclass ProfileInspector:\n    def balance(self, state: ProfileState):\n        return state.balance\n\n    def status(self, state: ProfileState):\n        return state.status\n\n    def limit(self, state: ProfileState):\n        return state.limit\n\n    def tier(self, state: ProfileState):\n        return state.tier\n\n[file]\npath=mini_search_engine/storage.py\n\nclass Storage:\n    def __init__(self):\n        self.items = {}\n\n    def save(self, key, value):\n        self.items[key] = value\n        return key\n\n[file]\npath=mini_search_engine/tokenizer.py\n\nclass Tokenizer:\n    def split(self, text: str):\n        return [t for t in text.replace(\".\", \" \").split() if t]\n\n",
