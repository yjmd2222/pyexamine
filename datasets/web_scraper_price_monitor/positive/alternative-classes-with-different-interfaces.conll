# Pricing notes	O

# - Cache values are stored per vendor.	O

# - We only reconcile once per hour.	O

# - Discounts are ignored if the seller is unknown.	O

# - Shipping fees are tracked separately.	O

# - Price drops smaller than 1% are ignored.	O

# - Coupons are applied after tax rules.	O

# - Manual overrides require operator approval.	O

# - Scrapes during maintenance windows are skipped.	O

flag_one	O
=	O
True	O

# Inventory notes	O

# - Backorders are tracked separately.	O

# - Warehouse holds are recorded in tickets.	O

# - Inventory locks expire after 15 minutes.	O

# - Vendor blocks are kept for 30 days.	O

# - Sync retries happen every 5 minutes.	O

# - Stock overrides require supervisor approval.	O

flag_two	O
=	O
True	O

# Alert notes	O

# - Pagers are used for critical alerts.	O

# - SMS is used when email bounces.	O

# - Night shifts have separate rotations.	O

# - Alerts are suppressed during outages.	O

# - Escalations happen after 3 attempts.	O

# - Suppression windows expire at midnight.	O

flag_three	O
=	O
True	O

# Audit notes	O

# - Price edits are logged with operator IDs.	O

# - Audit trails are archived monthly.	O

# - Anomaly checks run daily.	O

# - Fraud checks are scheduled weekly.	O

# - Chargebacks are reviewed quarterly.	O

# - Policy changes require two approvals.	O

flag_four	O
=	O
True	O

# Compliance notes	O

# - Retention rules differ by region.	O

# - GDPR exports run on request.	O

# - HIPAA rules apply to health vendors.	O

# - PCI scans run after release.	O

# - Tokens are rotated every 90 days.	O

# - External audits happen annually.	O

flag_five	O
=	O
True	O

# Operations notes	O

# - Rollbacks are manual during outages.	O

# - Maintenance windows are scheduled.	O

# - Vendor rates change without notice.	O

# - Contract renewals are quarterly.	O

# - Canary deploys take 2 hours.	O

# - Hotfixes require approvals.	O

flag_six	O
=	O
True	O

# Support notes	O

# - On-call rotations are monthly.	O

# - Escalation docs are in the handbook.	O

# - Vendor bridges are recorded.	O

# - Major incidents require postmortems.	O

# - Incident reviews happen weekly.	O

# - Pager overrides expire in 24 hours.	O

flag_seven	O
=	O
True	O

# Metrics notes	O

# - Latency percentiles are stored hourly.	O

# - Error rates are sampled per region.	O

# - Throughput is averaged by vendor.	O

# - Backoff rates are recorded.	O

# - Retry storms are throttled.	O

# - Cache hit ratios are persisted.	O

flag_eight	O
=	O
True	O

