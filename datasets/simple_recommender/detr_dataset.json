     total += 1\n        return total\n\n    def score_window(self, a, b, c, d, e):\n        total = 0\n        if a + b > c:\n            total += 1\n        if b + c > d:\n            total += 1\n        if c + d > e:\n            total += 1\n        if d + e > a:\n            total += 1\n        return total\n\n    def score_final(self, a, b, c, d, e):\n        total = 0\n        if a - b > 0:\n            total += 1\n        if b - c > 0:\n            total += 1\n        if c - d > 0:\n            total += 1\n        if d - e > 0:\n            total += 1\n        return total\n\n",
