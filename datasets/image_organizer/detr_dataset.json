\n        elif mode == \"year\":\n            return \"year\"\n        else:\n            return \"default\"\n\n[file]\npath=image_organizer/lifecycle.py\n\nclass GalleryLifecycle:\n    def start_import(self):\n        state = \"start_import\"\n        return state\n\n    def stop_import(self):\n        state = \"stop_import\"\n        return state\n\n    def start_sync(self):\n        state = \"start_sync\"\n        return state\n\n    def stop_sync(self):\n        state = \"stop_sync\"\n        return state\n\n    def start_share(self):\n        state = \"start_share\"\n        return state\n\n    def stop_share(self):\n        state = \"stop_share\"\n        return state\n\n    def start_backup(self):\n        state = \"start_backup\"\n        return state\n\n    def stop_backup(self):\n        state = \"stop_backup\"\n        return state\n\n    def start_cleanup(self):\n        state = \"start_cleanup\"\n        return state\n\n    def stop_cleanup(self):\n        state = \"stop_cleanup\"\n        return state\n\n    def start_scan(self):\n        state = \"start_scan\"\n        return state\n\n    def stop_scan(self):\n        state = \"stop_scan\"\n        return state\n\n    def start_sort(self):\n        state = \"start_sort\"\n        return state\n\n    def stop_sort(self):\n        state = \"stop_sort\"\n        return state\n\n    def start_rebuild(self):\n        state = \"start_rebuild\"\n        return state\n\n    def stop_rebuild(self):\n        state = \"stop_rebuild\"\n        return state\n\n[file]\npath=image_organizer/rules.py\n\nclass RetentionPolicy:\n    def __init__(self, keep_raw: bool, keep_edits: bool):\n        self.keep_raw = keep_raw\n        self.keep_edits = keep_edits\n        self._cache_hint = \"hot\"\n\n    def apply(self, album):\n        if self.keep_raw:\n            album.raw = True\n        if self.keep_edits:\n            album.edits = True\n        return album\n\n",
